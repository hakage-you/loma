{
  /*
   * テスト側の型チェック用。**本体の tsconfig.json は "include": ["src"] なので、
   * e2e / perf / playwright の設定ファイルは一度も型チェックされない。**
   *
   * Playwright は TypeScript を esbuild で変換するだけで型は見ないため、
   * 型の取り違えがあっても実行時まで分からない（そして実行時に落ちなければ
   * テストは緑のまま通る）。ここで別途チェックする。
   *
   * 実行: npm run check:types
   */
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["e2e", "perf", "playwright.config.ts", "playwright.perf.config.ts"]
}
